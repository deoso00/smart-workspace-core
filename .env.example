# Copy these into Lovable Cloud secrets / env (required for chat + workspace).
# Values come from Lovable → Connect Supabase (publishable key only).
# ZAnto accetta SIA i nomi VITE_* SIA i nomi SUPABASE_* (stessi valori).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side aliases (stessi valori dei VITE_* — utili su Vercel / desktop)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Opzionale
# GEMINI_API_KEY=
