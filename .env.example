# Copy these into Lovable Cloud secrets / env (required for chat + workspace).
# Values come from Lovable → Connect Supabase (publishable key only).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side aliases (optional, same values)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
